# FalkorDB Connection Settings
# For Local Docker:
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH=forktrace

# For FalkorDB Cloud:
# FALKORDB_HOST=your-instance.falkordb.cloud
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=your_cloud_password
# FALKORDB_SSL=true
# FALKORDB_GRAPH=forktrace

# Scoring Thresholds
INFERRED_WEIGHT=0.5
HIGH_LEAD_RATIO=2.0
HIGH_ATTACK=0.7
LOW_LEAD_RATIO=1.2
MIN_CASES=5

